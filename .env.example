NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only AES-256-GCM key: 32 random bytes encoded as exactly 64 hex characters.
# Run npm run setup:external-accounts to initialize .env.local without printing secrets.
# Development/test can reuse a generated, gitignored .env.external-accounts.key when unset.
# Production: configure this exact plural name in the Next.js host (e.g. Vercel Production), then redeploy.
# Supabase Vault/Edge Functions secrets and EXTERNAL_ACCOUNT_ENCRYPTION_KEY are not read.
# Production requires an explicit key. Use the SAME key for every environment using the same DB.
# Never use NEXT_PUBLIC_, a shared example/default value, or rotate without re-encryption.
EXTERNAL_ACCOUNTS_ENCRYPTION_KEY=

# Development only: allows only http://127.0.0.1:54321 (production/test reject true).
SUPABASE_LOCAL_TEST=false

# Enable only after validation in a separate test Supabase project. Default: disabled.
CERTIFICATES_ENABLED=false

# SOLAPI server-only credentials. Never use NEXT_PUBLIC_ for these variables.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
SOLAPI_ADMIN_NOTIFY_NUMBER=
